 @startuml CardCreator Architecture

!define ACCENT #FF6B6B
!define PRIMARY #4ECDC4
!define SECONDARY #45B7D1
!define LIGHT #F0F0F0
!define DARK #2C3E50

skinparam backgroundColor LIGHT
skinparam componentBackgroundColor #FFFFFF
skinparam componentBorderColor DARK
skinparam packageBackgroundColor LIGHT
skinparam packageBorderColor DARK
skinparam arrowColor DARK

package "CardCreator Ecosystem" {

  package "CLI Module" {
    component [CLI] as CLI
  }

  package "WebApp Module" {
    component [WebApp] as WEBAPP
  }

  package "CardCreator Library" {

    package "Public API Layer" {
      component [CardCreatorLibrary] as MAIN_API
      note on link MAIN_API
        Entry point for consumers
        Orchestrates all components
      end note
    }

    package "Interaction Layer" {
      component [CommandDispatcher] as DISPATCHER
      component [CommandHandlers] as HANDLERS
      component [Commands] as COMMANDS

      DISPATCHER --> HANDLERS: routes
      HANDLERS --> COMMANDS: processes
      note on link DISPATCHER
        Routes commands to handlers
        Manages execution context
        Correlation tracking
      end note
    }

    package "Core Components" {
      component [EventBus] as EVENTBUS
      component [LoggerRegistry] as LOGGER
      component [Asset Cache] as CACHE

      note on link EVENTBUS
        Event publishing/subscription
        Multi-event (conjunction) handlers
        Priority-based execution
      end note

      note on link LOGGER
        Singleton pattern
        Custom logger injection
      end note

      note on link CACHE
        Multiple implementations
        InMemory, LRU, NoOp
      end note
    }

    package "Domain Types" {
      component [Events] as EVENTS
      component [Domain Interfaces] as DOMAIN

      note on link EVENTS
        JobStarted/Finished
        ProjectLoaded/FileOpened
        CardRenderStarted/Finished
        AssetLoaded, Error
      end note

      note on link DOMAIN
        Logger, CardRenderer
        AssetCache, Asset classes
      end note
    }
  }
}

MAIN_API --> DISPATCHER: delegates
MAIN_API --> EVENTBUS: publishes/subscribes
MAIN_API --> LOGGER: gets
MAIN_API --> CACHE: manages

DISPATCHER --> EVENTBUS: publishes events
HANDLERS --> EVENTBUS: publishes events
HANDLERS --> LOGGER: logs operations
HANDLERS --> CACHE: caches assets

EVENTBUS --> EVENTS: emits
EVENTBUS --> LOGGER: logs

CLI --> MAIN_API: uses
WEBAPP --> MAIN_API: uses

CLI --> MAIN_API: executes commands
WEBAPP --> MAIN_API: executes commands

CLI -.->|subscribes to| EVENTBUS
WEBAPP -.->|subscribes to| EVENTBUS

legend right
  Event Flow ----->
  Dependency ....->
  Usage ----->
end legend

@enduml
